{
  "name": "msc-event-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Strictly read-only support CLI for MSC Event registrations",
  "type": "module",
  "bin": {
    "msc-event": "dist/src/cli.js",
    "approved-actions-bootstrap": "dist/src/passkey-bootstrap-operator-cli.js"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./plugin/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:approval": "npm run build && node --test dist/test/approval.test.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "commander": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "openclaw": {
    "extensions": [
      "./plugin/index.mjs"
    ]
  }
}
